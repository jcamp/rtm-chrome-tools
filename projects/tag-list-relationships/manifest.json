{
  "manifest_version": 3,
  "name": "Tag & List Relationships",
  "version": "0.2.6",
  "description": "Read-only overview of Remember The Milk lists and tags.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.rememberthemilk.com/*"
  ],
  "action": {
    "default_title": "Tag & List Relationships",
    "default_popup": "popup.html"
  }
}
