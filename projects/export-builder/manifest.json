{
  "manifest_version": 3,
  "name": "RTM Export Builder",
  "version": "0.1.2",
  "description": "Read-only configurable CSV and TSV export for Remember The Milk.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.rememberthemilk.com/*",
    "https://www.rememberthemilk.com/*"
  ],
  "action": {
    "default_title": "RTM Export Builder",
    "default_popup": "popup.html"
  }
}
